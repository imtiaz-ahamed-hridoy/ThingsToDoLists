# ==============================================================================
# Things To Do Lists (Royalloge Engine) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit real credentials, production keys, or server secrets to Git.
# ==============================================================================

# ── Application Configuration ───────────────────────────────────────────────
APP_NAME="Things To Do Lists"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
FRONTEND_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database Configuration ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royalloge_dev
DB_USERNAME=root
DB_PASSWORD=

# ── Session & Storage ───────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# ── Queue & Cache Configuration ─────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
DB_QUEUE_RETRY_AFTER=1500

# ── Redis (Recommended for Production) ──────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail Configuration ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Stripe Payment Gateway ──────────────────────────────────────────────────
CASHIER_LOGGER=stack
STRIPE_KEY=pk_test_placeholder_key_here
STRIPE_SECRET=sk_test_placeholder_secret_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# ── Bókun API (TripAdvisor Company) ─────────────────────────────────────────
BOKUN_ACCESS_KEY=your_bokun_access_key_here
BOKUN_SECRET_KEY=your_bokun_secret_key_here
BOKUN_API_URL=https://api.bokun.io

# ── GlobalTix OTA Ticketing API ─────────────────────────────────────────────
# Mode: prod | test
GLOBALTIX_MODE=test

# Production credentials (sg-api)
GLOBALTIX_PROD_BASE_URL=https://sg-api.globaltix.com
GLOBALTIX_PROD_API_USER=your_prod_user@example.com
GLOBALTIX_PROD_API_KEY=your_prod_api_key_here
GLOBALTIX_PROD_API_AGENT=your_prod_agent_code

# Staging credentials (stg-api)
GLOBALTIX_TEST_BASE_URL=https://stg-api.globaltix.com
GLOBALTIX_TEST_API_USER=your_test_user@example.com
GLOBALTIX_TEST_API_KEY=your_test_api_key_here
GLOBALTIX_TEST_API_AGENT=your_test_agent_code

# Image CDN & Webhooks
GLOBALTIX_IMAGE_URL=https://product-image.globaltix.com/live-gtImage/
GLOBALTIX_WEBHOOK_SECRET=your_globaltix_webhook_secret_here
GLOBALTIX_WEBHOOK_REQUIRE_SIGNATURE=false

# Optional event-specific webhook secrets
GLOBALTIX_WEBHOOK_SECRET_BOOKING_TICKET_UPDATE=
GLOBALTIX_WEBHOOK_SECRET_BOOKING_TRANSACTION_UPDATE=
GLOBALTIX_WEBHOOK_SECRET_TICKET_REDEEM=
GLOBALTIX_WEBHOOK_SECRET_TICKET_REVOKE=
GLOBALTIX_WEBHOOK_SECRET_TICKET_EXPIRED=
GLOBALTIX_WEBHOOK_SECRET_PRODUCT_INFO_UPDATE=
GLOBALTIX_WEBHOOK_SECRET_PRICE_UPDATE=

# ── PayPal API (REST v2) ────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=